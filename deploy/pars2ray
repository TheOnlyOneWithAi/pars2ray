#!/usr/bin/env bash
set -Eeuo pipefail

INSTALL_DIR="${PARS2RAY_INSTALL_DIR:-/opt/pars2ray}"
ENV_FILE="/etc/pars2ray/pars2ray.env"
CREDENTIALS_FILE="/etc/pars2ray/credentials"
CLI_PATH="/usr/local/bin/pars2ray"

fail(){ echo "[pars2ray] ERROR: $*" >&2; exit 1; }
[[ "$(id -u)" == 0 ]] || fail "Run as root."
[[ -d "$INSTALL_DIR" ]] || fail "Pars2Ray is not installed at $INSTALL_DIR"
command -v systemctl >/dev/null 2>&1 || fail "systemctl is required"

load_env(){
  [[ -r "$ENV_FILE" ]] || fail "Pars2Ray environment file not found: $ENV_FILE"
  set -a
  # shellcheck disable=SC1090
  . "$ENV_FILE"
  set +a
}

runtime_python(){ [[ -x "$INSTALL_DIR/.venv/bin/python" ]] || fail "Pars2Ray Python environment not found"; printf '%s' "$INSTALL_DIR/.venv/bin/python"; }

restart_services(){
  systemctl daemon-reload
  systemctl restart pars2ray-master.service
  systemctl restart pars2ray-worker.service
}

wait_health(){
  local port="${PANEL_HTTP_PORT:-8000}" i
  for i in $(seq 1 30); do
    if curl -fsS --connect-timeout 1 --max-time 2 "http://127.0.0.1:${port}/health" >/dev/null 2>&1; then return 0; fi
    sleep 1
  done
  journalctl -u pars2ray-master.service -n 80 --no-pager >&2 || true
  return 1
}

verify_live_login(){
  local user="$1" password="$2" port="${PANEL_HTTP_PORT:-8000}"
  PARS2RAY_VERIFY_USER="$user" PARS2RAY_VERIFY_PASSWORD="$password" PARS2RAY_VERIFY_PORT="$port" PYTHONPATH="$INSTALL_DIR/master" "$(runtime_python)" - <<'PY'
import json, os, sys, urllib.error, urllib.request
url=f"http://127.0.0.1:{os.environ['PARS2RAY_VERIFY_PORT']}/api/v1/auth/login"
payload=json.dumps({'username':os.environ['PARS2RAY_VERIFY_USER'],'password':os.environ['PARS2RAY_VERIFY_PASSWORD']}).encode()
req=urllib.request.Request(url,data=payload,headers={'Content-Type':'application/json'},method='POST')
try:
    with urllib.request.urlopen(req,timeout=10) as r:
        body=r.read().decode('utf-8','replace')
        if r.status != 200: raise RuntimeError(f'HTTP {r.status}: {body[:300]}')
        data=json.loads(body)
        if not data.get('access_token') or not data.get('refresh_token'): raise RuntimeError('login response did not contain both tokens')
except urllib.error.HTTPError as e:
    body=e.read().decode('utf-8','replace')
    print(f'HTTP {e.code}: {body[:300]}',file=sys.stderr); raise SystemExit(2)
except Exception as e:
    print(str(e),file=sys.stderr); raise SystemExit(3)
PY
}

change_password(){
  load_env
  local user="${ADMIN_USER:-}" password confirm
  [[ -n "$user" ]] || fail "ADMIN_USER is not configured"
  if [[ -n "${PARS2RAY_NEW_PASSWORD:-}" ]]; then
    password="$PARS2RAY_NEW_PASSWORD"
  else
    while :; do
      read -r -s -p "New Pars2Ray panel password for ${user} (12+ chars): " password || true; printf '\n'
      (( ${#password} >= 12 )) || { echo "[pars2ray] Password must be at least 12 characters." >&2; continue; }
      read -r -s -p "Confirm new password: " confirm || true; printf '\n'
      [[ "$password" == "$confirm" ]] || { echo "[pars2ray] Passwords do not match." >&2; continue; }
      break
    done
  fi
  (( ${#password} >= 12 )) || fail "Password must be at least 12 characters"

  local old_password="${ADMIN_PASSWORD:-}"
  [[ -n "$old_password" ]] || fail "ADMIN_PASSWORD is not configured"

  echo "[pars2ray] Updating the panel password..."
  PARS2RAY_TARGET_USER="$user" PARS2RAY_NEW_PASSWORD="$password" PYTHONPATH="$INSTALL_DIR/master" "$(runtime_python)" - <<'PY'
import os
from sqlalchemy import select
from app.core.security import hash_password, verify_password
from app.db.base import SessionLocal
from app.models.entities import User
u=os.environ['PARS2RAY_TARGET_USER']; p=os.environ['PARS2RAY_NEW_PASSWORD']
db=SessionLocal()
try:
    user=db.scalar(select(User).where(User.username==u))
    if user is None: raise RuntimeError(f'user not found: {u}')
    h=hash_password(p)
    if not verify_password(p,h): raise RuntimeError('new hash self-verification failed')
    user.password_hash=h
    user.is_active=True
    db.commit()
    db.expire_all()
    check=db.scalar(select(User).where(User.username==u))
    if check is None or not verify_password(p,check.password_hash): raise RuntimeError('database verification failed after commit')
finally:
    db.close()
PY

  local tmp="${ENV_FILE}.tmp.$$"
  awk -v v="$password" 'BEGIN{done=0} /^ADMIN_PASSWORD=/{if(!done){print "ADMIN_PASSWORD=" v;done=1};next} {print} END{if(!done)print "ADMIN_PASSWORD=" v}' "$ENV_FILE" > "$tmp"
  chmod 0600 "$tmp"; mv -f "$tmp" "$ENV_FILE"

  if [[ -f "$CREDENTIALS_FILE" ]]; then
    local panel host port
    panel="$(grep '^Panel: ' "$CREDENTIALS_FILE" || true)"
    host="$(printf '%s\n' "$panel" | sed -n 's#^Panel: http://\([^:]*\):.*#\1#p')"
    port="$(printf '%s\n' "$panel" | sed -n 's#^Panel: .*:\([0-9][0-9]*\)$#\1#p')"
    cat > "$CREDENTIALS_FILE" <<EOF
Pars2Ray installation
=====================
Panel: http://${host:-localhost}:${port:-${PANEL_HTTP_PORT:-8000}}
Username: ${user}
Password: ${password}

Keep this file private. It is readable only by root.
EOF
    chmod 0600 "$CREDENTIALS_FILE"
  fi

  restart_services
  if ! wait_health; then
    fail "Panel did not become healthy after password change"
  fi
  if ! verify_live_login "$user" "$password"; then
    echo "[pars2ray] Live panel rejected the new password; restoring the previous password..." >&2
    PARS2RAY_TARGET_USER="$user" PARS2RAY_NEW_PASSWORD="$old_password" PYTHONPATH="$INSTALL_DIR/master" "$(runtime_python)" - <<'PY'
import os
from sqlalchemy import select
from app.core.security import hash_password
from app.db.base import SessionLocal
from app.models.entities import User
u=os.environ['PARS2RAY_TARGET_USER']; p=os.environ['PARS2RAY_NEW_PASSWORD']
db=SessionLocal()
try:
    user=db.scalar(select(User).where(User.username==u))
    if user is not None:
        user.password_hash=hash_password(p); db.commit()
finally: db.close()
PY
    local tmp2="${ENV_FILE}.tmp.$$"
    awk -v v="$old_password" 'BEGIN{done=0} /^ADMIN_PASSWORD=/{if(!done){print "ADMIN_PASSWORD=" v;done=1};next} {print} END{if(!done)print "ADMIN_PASSWORD=" v}' "$ENV_FILE" > "$tmp2"
    chmod 0600 "$tmp2"; mv -f "$tmp2" "$ENV_FILE"
    restart_services || true
    fail "Live panel rejected the new password; change was rolled back"
  fi
  echo "[pars2ray] Password changed successfully. Live login verification passed."
}

diagnose_auth(){
  load_env
  local user="${ADMIN_USER:-}" port="${PANEL_HTTP_PORT:-8000}"
  [[ -n "$user" ]] || fail "ADMIN_USER is not configured"
  echo "[pars2ray] Authentication diagnostics"
  echo "  user: $user"
  echo "  database: $(printf '%s' "${DATABASE_URL:-}" | sha256sum | cut -c1-12)"
  echo "  master: $(systemctl is-active pars2ray-master.service 2>/dev/null || true)"
  echo "  panel: http://127.0.0.1:${port}"
  PYTHONPATH="$INSTALL_DIR/master" "$(runtime_python)" - <<'PY'
from sqlalchemy import select
from app.core.config import settings
from app.db.base import SessionLocal
from app.models.entities import User
import hashlib
print('  python database:',hashlib.sha256(settings.database_url.encode()).hexdigest()[:12])
db=SessionLocal()
try:
    for u in db.scalars(select(User)).all(): print(f'  db user: {u.username} active={u.is_active} hash_prefix={u.password_hash[:12]}')
finally: db.close()
PY
}

update(){
  [[ -x "$INSTALL_DIR/deploy/install.sh" ]] || fail "Installer not found: $INSTALL_DIR/deploy/install.sh"
  echo "[pars2ray] Running the full native installer/update..."
  exec bash "$INSTALL_DIR/deploy/install.sh"
}

case "${1:-help}" in
  update) update ;;
  change-password|password) change_password ;;
  diagnose-auth) diagnose_auth ;;
  start) systemctl start pars2ray-master.service pars2ray-worker.service ;;
  stop) systemctl stop pars2ray-worker.service pars2ray-master.service ;;
  restart) restart_services ;;
  status|ps) systemctl --no-pager --full status pars2ray-master.service pars2ray-worker.service ;;
  logs) journalctl -u pars2ray-master.service -u pars2ray-worker.service --no-pager -n "${PARS2RAY_LOG_LINES:-150}" ;;
  master-logs) journalctl -u pars2ray-master.service --no-pager -n "${PARS2RAY_LOG_LINES:-150}" ;;
  worker-logs) journalctl -u pars2ray-worker.service --no-pager -n "${PARS2RAY_LOG_LINES:-150}" ;;
  config) load_env; sed -E 's/^(ADMIN_PASSWORD|JWT_SECRET|MASTER_SECRET)=.*/\1=***REDACTED***/' "$ENV_FILE" ;;
  install|reinstall) exec bash "$INSTALL_DIR/deploy/install.sh" ;;
  shell) exec bash ;;
  uninstall) systemctl disable --now pars2ray-worker.service pars2ray-master.service 2>/dev/null || true; rm -f /etc/systemd/system/pars2ray-master.service /etc/systemd/system/pars2ray-worker.service "$CLI_PATH"; systemctl daemon-reload; echo "[pars2ray] Services removed; project files remain in $INSTALL_DIR." ;;
  help|-h|--help) cat <<'EOF'
Pars2Ray management CLI

  update             Run the complete native installer/update
  change-password    Change panel password and verify live login
  password           Alias for change-password
  diagnose-auth      Show safe authentication/database diagnostics
  start|stop|restart Manage Pars2Ray services
  status             Show service status
  logs               Show master and worker logs
  master-logs        Show master logs
  worker-logs        Show worker logs
  config             Show config with secrets redacted
  install            Run installer
  uninstall          Remove services (keeps project files)
EOF
    ;;
  *) fail "Unknown command '$1'. Run 'pars2ray help'." ;;
esac
