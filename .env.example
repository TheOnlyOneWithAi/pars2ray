# Pars2Ray Native Installer v2
# The installer generates secure secrets and fills these values automatically.
ENVIRONMENT=production
DEBUG=false
PANEL_HTTP_PORT=8000
DATABASE_URL=sqlite:////opt/pars2ray/data/pars2ray.db
REDIS_URL=
JWT_SECRET=replace-with-64-character-secret
MASTER_SECRET=replace-with-64-character-secret
ADMIN_USER=admin
ADMIN_PASSWORD=replace-with-strong-admin-password
ADMIN_EMAIL=admin@example.com
CORS_ORIGINS=
TRUSTED_HOSTS=localhost,127.0.0.1
RATE_LIMIT_PER_MINUTE=120

AI_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_REQUEST_TIMEOUT_SECONDS=15
AI_MIN_SCORE_CHANGE=5
AI_SWITCH_MIN_IMPROVEMENT=10
AI_REQUIRED_WINS=3
AI_MAX_OUTPUT_TOKENS=180
AI_PROMPT_CACHE_KEY=pars2ray-optimizer-v3

NODE_POLL_SECONDS=30
AGENT_REQUEST_TIMEOUT_SECONDS=10
NATIONAL_MODE_ENABLED=true
NATIONAL_FAILURE_THRESHOLD=3
NATIONAL_RECOVERY_THRESHOLD=2
NATIONAL_MAX_CANDIDATES_PER_ROUND=30
