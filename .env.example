# Pars2Ray Enterprise configuration
ENVIRONMENT=production
DEBUG=false
PANEL_HTTP_PORT=8000

# Generate with: openssl rand -hex 32
JWT_SECRET=replace-with-64-character-secret
MASTER_SECRET=replace-with-64-character-secret
ADMIN_USER=admin
ADMIN_PASSWORD=replace-with-strong-admin-password
ADMIN_EMAIL=admin@example.com

POSTGRES_PASSWORD=replace-with-strong-database-password
DATABASE_URL=postgresql+psycopg://pars2ray:${POSTGRES_PASSWORD}@db:5432/pars2ray
REDIS_URL=redis://redis:6379/0
CORS_ORIGINS=
TRUSTED_HOSTS=localhost,127.0.0.1
RATE_LIMIT_PER_MINUTE=120

# AI is optional. Local rules and experiment memory remain active without it.
AI_ENABLED=true
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_BASE_URL=https://api.openai.com/v1
AI_MIN_SCORE_CHANGE=5
AI_SWITCH_MIN_IMPROVEMENT=10
AI_REQUIRED_WINS=3
AI_MAX_OUTPUT_TOKENS=500
AI_PROMPT_CACHE_KEY=pars2ray-optimizer-v2

NODE_POLL_SECONDS=30
AGENT_REQUEST_TIMEOUT_SECONDS=10
NATIONAL_MODE_ENABLED=true
NATIONAL_FAILURE_THRESHOLD=3
NATIONAL_RECOVERY_THRESHOLD=2
NATIONAL_MAX_CANDIDATES_PER_ROUND=30

# Master bootstrap SSH access. Used only by installer/bootstrap.py.
PANEL_IP=
PANEL_USER=root
PANEL_PASS=
PANEL_PORT=22

# Every non-empty *_IP entry is a node. Supports DE1, DE2, DE3... and any ISO-like prefix.
DE1_IP=
DE1_USER=root
DE1_PASS=
DE1_PORT=22
NL1_IP=
NL1_USER=root
NL1_PASS=
NL1_PORT=22
TR1_IP=
TR1_USER=root
TR1_PASS=
TR1_PORT=22
